{
  "include": ["src/", "scripts/"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "noEmit": true,
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types", "bun-types"],
    "skipLibCheck": true,
    "strict": true
  },
  "exclude": ["scripts/lint.ts"]
}
